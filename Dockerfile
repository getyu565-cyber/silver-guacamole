# Stage 1: Downloader stage
FROM ollama/ollama:latest AS downloader

# Install curl and Node.js
RUN apt-get update && \
    apt-get install -y curl nodejs && \
    rm -rf /var/lib/apt/lists/*

# Copy only the Node.js setup script
COPY setup-ollama.js /setup-ollama.js

# Run the Node.js script to serve, signin, and pull llama3.2
RUN node /setup-ollama.js

# Stage 2: Final clean image containing pre-downloaded llama3.2 and session state
FROM ollama/ollama:latest

# Copy pre-downloaded model assets and session state generated by Node script
COPY --from=downloader /root/.ollama /root/.ollama

EXPOSE 11434
